# Copy to .env and adjust. Never commit .env.
DATABASE_URL="postgresql://parking:parking_dev_password@localhost:5433/parking?schema=public"

# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-change-me-change-me-change-me"
SESSION_TTL_HOURS=168

# Public origin, used for the CSRF Origin check and absolute links
APP_ORIGIN="http://localhost:3000"

# Phase 4+
REDIS_URL="redis://localhost:6380"

# Phase 3+ (adapters; see docs/ARCHITECTURE.md risk 2)
GEOCODER_PROVIDER="none"
ROUTING_PROVIDER="none"

# Phase 5+ : "mock" is NOT a live integration
PAYMENT_PROVIDER="mock"
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""
